# Copy to .env (or configure in Render Environment Variables)
# Hugging Face token with access to your Inference Endpoints
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dedicated Hugging Face Inference Endpoints (OpenAI-compatible base URLs)
NOVA_SPARK_API_BASE=https://your-spark-endpoint.endpoints.huggingface.cloud
NOVA_SPARK_MODEL=LiquidAI/LFM3-VL-2B-GGUF

NOVA_PRO_API_BASE=https://your-pro-endpoint.endpoints.huggingface.cloud
NOVA_PRO_MODEL=bartowski/MiMo-V2.6-Distill-Qwen-9B-GGUF

NOVA_PLAMO_API_BASE=https://your-plamo-endpoint.endpoints.huggingface.cloud
NOVA_PLAMO_MODEL=Eiki-AI/plamo-3-translate-2b-af-q4_k_m

# Optional per-endpoint key overrides (defaults to NOVA_API_KEY / HF_TOKEN)
# NOVA_SPARK_API_KEY=
# NOVA_PRO_API_KEY=
# NOVA_PLAMO_API_KEY=

# Optional local overrides for PLaMo GGUF filename auto-detection
# NOVA_PLAMO_REPO=Eiki-AI/plamo-3-translate-2b-af-q4_k_m
# NOVA_PLAMO_FILE=

# Optional integrations
# TBA_AUTH_KEY=
# GITHUB_TOKEN=
