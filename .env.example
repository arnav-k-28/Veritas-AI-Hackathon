# Set these in Hugging Face Space Settings -> Variables & Secrets (all $0 / no card needed)

# Fast GPU Pro tier via OpenRouter free tier (no credit card required for :free models)
NOVA_PRO_API_BASE=https://openrouter.ai/api/v1
NOVA_PRO_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOVA_PRO_MODEL=openrouter/free

# Spark (LiquidAI/LFM3-VL-2B-GGUF) & PLaMo (Eiki-AI/plamo-3-translate-2b-af-q4_k_m):
# Leave NOVA_SPARK_API_BASE / NOVA_PLAMO_API_BASE unset inside the HF Docker Space
# to run them directly on the Space's free 16 GB CPU, OR point Spark to OpenRouter too:
# NOVA_SPARK_API_BASE=https://openrouter.ai/api/v1
# NOVA_SPARK_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOVA_SPARK_MODEL=openrouter/free

# Optional local/HF PLaMo overrides
# NOVA_PLAMO_REPO=Eiki-AI/plamo-3-translate-2b-af-q4_k_m
# NOVA_PLAMO_FILE=plamo-3-af-ckpt7k-Q4_K_M.gguf

# Optional integrations
# TBA_AUTH_KEY=
# GITHUB_TOKEN=
