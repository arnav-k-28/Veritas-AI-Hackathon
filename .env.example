# Copy to .env (or configure in Render Environment Variables)
# Public Hugging Face ZeroGPU Space URL (auto-uses Gradio /gradio_api/call/* protocol)
NOVA_SPARK_API_BASE=https://eiki-ai-primer.hf.space
NOVA_SPARK_MODEL=LiquidAI/LFM3-VL-2B-GGUF

NOVA_PRO_API_BASE=https://eiki-ai-primer.hf.space
NOVA_PRO_MODEL=bartowski/MiMo-V2.6-Distill-Qwen-9B-GGUF

NOVA_PLAMO_API_BASE=https://eiki-ai-primer.hf.space
NOVA_PLAMO_MODEL=Eiki-AI/plamo-3-translate-2b-af-q4_k_m

# Optional Hugging Face token (needed for private Spaces or HF PRO ZeroGPU quota)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional local overrides for PLaMo GGUF filename auto-detection
# NOVA_PLAMO_REPO=Eiki-AI/plamo-3-translate-2b-af-q4_k_m
# NOVA_PLAMO_FILE=

# Optional integrations
# TBA_AUTH_KEY=
# GITHUB_TOKEN=
